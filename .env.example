# Copy to .env and fill in real values. Never commit the real .env.
# APNs and FCM are each independently optional -- leave either provider's
# block entirely empty to run with just the other one. At least one must be
# configured, or the service refuses to start (nothing to deliver to).
# Neither the .p8 key nor the FCM service account JSON is ever an env var or
# repo file -- both are mounted as read-only files/secrets, only their paths
# are configured here.

## APNs (iOS) -----------------------------------------------------------------

# Bare-metal / local run: path the process reads directly.
# docker-compose: this value is overridden inside the container (always
# /secrets/apns-key.p8); APNS_KEY_HOST_PATH below is what actually matters.
APNS_KEY_PATH=/secrets/AuthKey_XXXXXXXXXX.p8
# docker-compose only: absolute path on the HOST to the real .p8 file.
APNS_KEY_HOST_PATH=/opt/nks-talk-notify/secrets/AuthKey_XXXXXXXXXX.p8

APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX
APNS_TOPIC=com.nkshub.nextcloudtalk
# Legacy fallback for APNs registrations created before pushEnvironment was
# added. New clients register development (debug) or production
# (Profile/Release/TestFlight) per device, so both environments work together.
# 1 = development fallback, 0 = production fallback.
APNS_USE_SANDBOX=0

## FCM (Android) ---------------------------------------------------------------

FCM_PROJECT_ID=
# Bare-metal / local run: path the process reads directly.
# docker-compose: overridden inside the container (always
# /secrets/fcm-service-account.json); FCM_SERVICE_ACCOUNT_HOST_PATH matters.
FCM_SERVICE_ACCOUNT_PATH=/secrets/fcm-service-account.json
# docker-compose only: absolute path on the HOST to the real service account
# JSON. Leave unset (with FCM_PROJECT_ID/FCM_SERVICE_ACCOUNT_PATH also
# unset) to run APNs-only -- docker-compose.yml falls back to mounting
# /dev/null so the container still starts cleanly.
FCM_SERVICE_ACCOUNT_HOST_PATH=

DB_PATH=/data/devices.db
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8080

# docker-compose only: host address the container port is published on.
# Keep this at 127.0.0.1 unless the reverse proxy lives on ANOTHER host and
# must reach this container over the LAN (e.g. an ISPConfig/Apache proxy on
# a separate server) -- then set it to this host's LAN IP, never 0.0.0.0.
BIND_ADDR=127.0.0.1

# The single peer address allowed to set X-Forwarded-For for rate-limiting
# purposes -- the reverse proxy in front of this service (matches BIND_ADDR's
# "reverse proxy on another host" case: this is that host's LAN IP). Leave
# empty to never trust X-Forwarded-For and rate-limit by the raw TCP peer
# instead -- safe default, but if a reverse proxy IS in front of this
# service, every request will then look like it came from that one proxy IP.
TRUSTED_PROXY_IP=

# Shared secret Nextcloud sends back as X-Nextcloud-Subscription-Key on every
# POST /notifications once this proxy's URL is set as the server's
# `subscription_aware_server` app config. Leave empty during first bring-up
# -- the service logs a warning and, fail closed, REJECTS every
# /notifications request until you set this (registration via /devices
# still works; only push delivery is gated). Never commit a real value.
#   occ config:app:set notifications subscription_aware_server \
#     --value="https://push.example.com"
#   occ config:app:get notifications push_subscription_key
NEXTCLOUD_SUBSCRIPTION_KEY=
