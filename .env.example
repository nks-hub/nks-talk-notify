# Copy to .env and fill in real values. Never commit the real .env.
# The .p8 private key itself is NEVER an env var or repo file -- it is
# mounted as a read-only file/secret and only its path is configured here.

# Bare-metal / local run: path the process reads directly.
# docker-compose: this value is overridden inside the container (always
# /secrets/apns-key.p8); APNS_KEY_HOST_PATH below is what actually matters.
APNS_KEY_PATH=/secrets/AuthKey_XXXXXXXXXX.p8
# docker-compose only: absolute path on the HOST to the real .p8 file.
APNS_KEY_HOST_PATH=/opt/nks-talk-notify/secrets/AuthKey_XXXXXXXXXX.p8

APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX
APNS_TOPIC=com.nkshub.nextcloudtalk
# 1 = api.sandbox.push.apple.com (debug/TestFlight builds), 0 = production
APNS_USE_SANDBOX=0

DB_PATH=/data/devices.db
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8080

# docker-compose only: host address the container port is published on.
# Keep this at 127.0.0.1 unless the reverse proxy lives on ANOTHER host and
# must reach this container over the LAN (e.g. an ISPConfig/Apache proxy on
# a separate server) -- then set it to this host's LAN IP, never 0.0.0.0.
BIND_ADDR=127.0.0.1

# Shared secret Nextcloud sends back as X-Nextcloud-Subscription-Key on every
# POST /notifications once this proxy's URL is set as the server's
# `subscription_aware_server` app config. Leave empty during first bring-up;
# the service logs a warning and runs unauthenticated on that endpoint until
# you set this. Never commit a real value.
#   occ config:app:set notifications subscription_aware_server \
#     --value="https://push.example.com"
#   occ config:app:get notifications push_subscription_key
NEXTCLOUD_SUBSCRIPTION_KEY=
